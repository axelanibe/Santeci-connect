# Copier vers .env et renseigner les valeurs
DATABASE_URL=postgresql://santeci:change-me-en-local@localhost:5432/santeci
# Mot de passe PostgreSQL local (docker-compose.yml)
POSTGRES_PASSWORD=change-me-en-local
# 32 octets aléatoires encodés en base64 (générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
MFA_ENC_KEY=
# Chiffrement applicatif des données de santé (colonnes *_enc).
# Provisoire comme MFA_ENC_KEY : à remplacer par un KMS/HSM avant toute donnée réelle.
DATA_ENC_KEY=
PORT=3000
